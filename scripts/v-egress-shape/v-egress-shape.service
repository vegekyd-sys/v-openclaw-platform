[Unit]
Description=Shape public egress with CAKE just under the 60 Mbps Lighthouse cap
Documentation=https://github.com/vegekyd-sys/v-openclaw-platform
# The 60 Mbps limit (50 before the 2026-10-21 upgrade) is enforced by a policer outside this host, so without
# local shaping the NIC queue never builds and fq_codel never acts: packets
# are dropped upstream indiscriminately and one bulk upload starves every
# model request. Shaping to 55 Mbps here keeps the queue on this host, where
# CAKE shares it fairly per flow. Installed 2026-09-21.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/tc qdisc replace dev eth0 root cake bandwidth 55mbit besteffort triple-isolate rtt 100ms
ExecStop=/usr/sbin/tc qdisc del dev eth0 root

[Install]
WantedBy=multi-user.target
