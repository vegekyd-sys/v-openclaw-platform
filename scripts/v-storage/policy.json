  "archive": {
    "bucket": "",
    "prefix": "archive/v",
    "cool_hours": 24,
    "rate_mb_s": 40,
    "max_bytes_per_run": 300000000000,
    "max_seconds_per_run": 18000,
    "categories": [
      {
        "name": "work",
