      },
      {
        "name": "output-alt-cold",
        "root": "/srv/openclaw-data/disk1/openclaw/output-alt",
        "action": "to-t2",
        "min_age_days": 90,
        "link_roots": [
          "/srv/openclaw-data/output-alt"
        ],
        "age_by": "mtime"
      },
      {
        "name": "work-cold",
        "root": "/srv/openclaw-data/disk1/work-archive",
        "action": "to-t2",
        "min_age_days": 180,
        "link_roots": [
          "/home/openclaw/makaron-openclaw/.openclaw-local/workspace/work"
        ],
        "age_by": "mtime"
      },
      {
        "name": "recovery",
        "root": "/srv/openclaw-data/disk1/openclaw/recovery",
        "action": "to-t2",
        "min_age_days": 30,
        "link_roots": [
          "/var/backups"
        ],
        "age_by": "mtime"
      },
      {
        "name": "media-inbound",
        "root": "/home/openclaw/.openclaw/media/inbound",
        "action": "to-t2",
