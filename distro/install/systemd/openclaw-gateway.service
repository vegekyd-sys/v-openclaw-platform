# v-distro: V's Gateway. Settings follow production V's openclaw-gateway.service and
# its drop-ins (2026-11-27): capacity, no swap, delegated memory cgroup for the native
# database verifier, the Codex orphan cleanup before start. Generated by `vctl units`.
[Unit]
Description=V (OpenClaw Gateway, v-distro)
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@HOME@
Environment=HOME=@HOME@
Environment=TMPDIR=/tmp
Environment=TZ=@TZ@
Environment=NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
Environment=PATH=@PREFIX@/bin:@PREFIX@/node/current/bin:@HOME@/.local/bin:@HOME@/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Environment=OPENCLAW_HOME=@HOME@
Environment=OPENCLAW_CONFIG_PATH=@HOME@/.openclaw/openclaw.json
Environment=OPENCLAW_GATEWAY_PORT=@PORT@
Environment=OPENCLAW_SYSTEMD_UNIT=openclaw-gateway.service
Environment=OPENCLAW_SERVICE_MARKER=openclaw
Environment=OPENCLAW_SERVICE_KIND=gateway
EnvironmentFile=@PREFIX@/current/runtime/gateway.env
EnvironmentFile=@PREFIX@/current/.release.env
EnvironmentFile=@ETC@/install.env
EnvironmentFile=@ETC@/secrets.env
# VSync identity (v-ctl vsync-env); absent on a machine without VSync.
EnvironmentFile=-@ETC@/vsync.env
# lark-cli's view of the Feishu app (written by configure when Feishu is set).
EnvironmentFile=-@ETC@/lark.env
# The same keys under other names some tools read (configure).
EnvironmentFile=-@ETC@/aliases.env
ExecStartPre=/usr/bin/python3 @PREFIX@/current/runtime/ops/v-codex-orphan-cleanup.py
ExecStart=@PREFIX@/node/current/bin/node --experimental-async-context-frame --max-old-space-size=@HEAP_MB@ @PREFIX@/current/core/dist/index.js gateway --port @PORT@
Restart=always
RestartSec=5
RestartPreventExitStatus=78
TimeoutStartSec=30
TimeoutStopSec=45
SuccessExitStatus=0 143
KillMode=mixed
OOMPolicy=continue
UMask=0077
LimitNOFILE=1048576
TasksMax=16384
MemoryAccounting=true
MemorySwapMax=0
Delegate=memory
DelegateSubgroup=foreground
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
