# Optional Cloudflare tunnel (v-distro): written only when CLOUDFLARE_TUNNEL_TOKEN is set.
# A token tunnel takes its public hostnames and routes from the Cloudflare dashboard, e.g.
#   v.example.com/desktop-handoff -> http://127.0.0.1:23950   (takeover links; then set V_PUBLIC_ORIGIN)
# The token comes from @ETC@/cloudflared.env (TUNNEL_TOKEN, 0600), never from the command line.
[Unit]
Description=V Cloudflare tunnel (v-distro)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
EnvironmentFile=@ETC@/cloudflared.env
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
