# Inputs for install/install.sh --env-file. Keys ending in _KEY/_SECRET/_TOKEN go to
# /etc/v/secrets.env (root, 0600); the rest to /etc/v/install.env. Never commit this file.

# Who V works for (the workspace reads it from .v/install.json).
V_OWNER_NAME=
TZ=Asia/Shanghai

# Model: deepseek (DeepSeek API; same /vds + Worker setup as V) or vercel (Vercel AI Gateway).
V_MODEL_PRESET=deepseek
DEEPSEEK_API_KEY=
# AI_GATEWAY_API_KEY=

# Feishu enterprise app (optional; leave empty to install without a channel).
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# The owner's open_id once known (ou_...). Without it the first DM gets a pairing code: v-ctl pair <code>.
V_OWNER_FEISHU_OPEN_ID=

# Optional providers.
# GOOGLE_API_KEY=      memory vector search (gemini-embedding)
# XAI_API_KEY=         image understanding / generation
# MAKARON_API_KEY=     Makaron creation (makaron-cli and the makaron-* skills read it from the environment;
#                      without it they say the account is not connected)
# APIFY_API_KEY=       social-media and image search skills
# V_WORKERS_MAX=4
# V_NPM_REGISTRY=https://registry.npmmirror.com

# Voice messages -> text (as on V): Volcengine BigASR Flash, new-console single key with
# "录音文件识别极速版" enabled. Without it, voice messages are not transcribed.
# VOLCENGINE_API_KEY=

# Desktop takeover and computer use: a headless host display (TigerVNC + XFCE, no GPU or Xvfb),
# headed Google Chrome from Google's signed apt repository, takeover links, the computer tool.
# About 0.5-1 GB more memory. amd64 only (Google Chrome).
# V_DESKTOP=1
# Where takeover links open. Unset: http://127.0.0.1:23950 (this machine only; from elsewhere
# use ssh -L 23950:127.0.0.1:23950). For a LAN or the internet, forward /desktop-handoff on
# your reverse proxy or tunnel to 127.0.0.1:23950 and set the origin it serves, no path:
# V_PUBLIC_ORIGIN=https://v.example.com

# Cloudflare tunnel for public links: a Zero Trust tunnel token (Networks -> Tunnels -> the tunnel's
# install command, the long string after --token). Routes are set in the Cloudflare dashboard,
# e.g. v.example.com/desktop-handoff -> http://127.0.0.1:23950, then V_PUBLIC_ORIGIN=https://v.example.com.
# CLOUDFLARE_TUNNEL_TOKEN=

# Night Shift: the URL of a running Night Shift service (vegekyd-sys/v-nightshift). Without it the
# workboard and the nightshift-feishu plugin stay off.
# V_NIGHTSHIFT_URL=http://127.0.0.1:24879

# VSync is not set here: pass the Portal-issued identity file with install.sh --vsync-env <file>.
# Anything added after the install (to /etc/v/install.env or /etc/v/secrets.env): sudo v-ctl reconfigure
