#!/usr/bin/env bash
# Operator entry on an installed host (linked to /usr/local/bin/v-ctl).
#   v-ctl status | health | probe [--check-history] | configure | units
#   v-ctl openclaw <args...>      the installed OpenClaw CLI as the service user, with its environment
#   v-ctl pair <code>             approve the owner's first Feishu DM (dmPolicy=pairing)
#   v-ctl backup [--keep N]       online backup to /var/backups/v/archives (0600); restore-backup <archive> --root DIR | --live
set -euo pipefail
PREFIX="${V_PREFIX:-/opt/v}"
NODE="$PREFIX/node/current/bin/node"
case "${1:-}" in
  openclaw|pair)
    [ "$(id -u)" -eq 0 ] || { echo "v-ctl $1: run as root" >&2; exit 1; }
    sub="$1"; shift
    [ "$sub" = pair ] && set -- pairing approve feishu "$@"
    exec python3 "$PREFIX/current/runtime/ops/v-memory-indexer-run.py" --cli "$@" ;;
  ""|-h|--help) sed -n '2,7p' "$0" ;;
  *) exec "$NODE" "$PREFIX/current/install/lib/vctl.mjs" "$@" ;;
esac
