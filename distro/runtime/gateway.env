# V's Gateway behaviour switches, copied from production V's openclaw-gateway.service
# drop-ins on 2026-11-27 (systemctl show -p Environment). No secrets and nothing
# host-specific; paths are the standalone layout's (/home/openclaw/.openclaw).
# Left out on purpose: OPENCLAW_CRON_SHARED_POLICY (V's /vcc cron policy file),
# OPENCLAW_SESSION_HOTSET_* (a no-op on SQLite sessions), V_DINGTALK_*,
# OPENCLAW_FEISHU_PHONE_TABS_FILE (V's voice phone entry), DISPLAY (desktop).
OPENCLAW_DB91_INTEGRITY_ENABLE=1
OPENCLAW_DB91_PROVENANCE_ENABLE=1
OPENCLAW_DB91_MEMORY_SCHEMA_ENABLE=1
OPENCLAW_DB91_MAINTENANCE_ENABLE=1
OPENCLAW_DB91_READ_AHEAD_ENABLE=1
OPENCLAW_DB91_STATE_READ_AHEAD_ENABLE=1
OPENCLAW_DB91_TRAJECTORY_SWEEP_ENABLE=1
OPENCLAW_DB91_PREFLIGHT_TIMEOUT_MS=3600000
OPENCLAW_DB91_INTEGRITY_STATE_ROOT=/home/openclaw/.openclaw
OPENCLAW_DATABASE_VERIFY_RESOURCE_GROUP=1
OPENCLAW_WORKER_SESSION_AFFINITY_ENABLE=1
OPENCLAW_FIRSTTEXT_WORKER_PHASES=1
OPENCLAW_PERSISTENT_CDP_CONNECT_TIMEOUT_MS=60000
OPENCLAW_EXTENSION_COMMAND_TIMEOUT_MS=180000
CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1
V_FEISHU_TASK_PRESENTATION=1
VLAB_FEISHU_STEER_ENABLED=1
VLAB_FEISHU_STEER_CHAT_IDS=*
