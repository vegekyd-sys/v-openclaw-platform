{
  "id": "vlab-agent-worker-isolation",
  "activation": {
    "onStartup": true
  },
  "name": "vLab Agent Worker Isolation",
  "description": "Routes native OpenClaw Agent Harness dispatch and vLab experiment RPCs to elastic child-process workers.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "minWorkers": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16
      },
      "maxWorkers": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16
      },
      "sessionsPerWorker": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3
      },
      "idleTimeoutMs": {
        "type": "integer",
        "minimum": 100,
        "maximum": 3600000
      },
      "requestTimeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 172800000
      },
      "requestStallTimeoutMs": {
        "type": "integer",
        "minimum": 30000,
        "maximum": 1800000
      },
      "requestCancelGraceMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 60000
      },
      "workerHeartbeatMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 60000
      },
      "gatewayOwnedToolTimeoutMs": {
        "type": "integer",
        "minimum": 30000,
        "maximum": 1800000
      },
      "workerConfigPath": {
        "type": "string",
        "minLength": 1
      },
      "gatewayConfigPath": {
        "type": "string",
        "minLength": 1
      },
      "fastCompactionModel": {
        "type": "string",
        "minLength": 1
      },
      "fastCompactionMaxInputChars": {
        "type": "integer",
        "minimum": 10000,
        "maximum": 1500000
      },
      "fastCompactionMaxOutputTokens": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 30000
      },
      "fastCompactionMaxQualityRetries": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1
      }
    }
  }
}
