{
  "meta": {
    "lastTouchedVersion": "2026.7.1-2"
  },
  "gateway": {
    "port": 24993,
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "${VLAB_VCODEX_GATEWAY_TOKEN}"
    },
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "reload": {
      "mode": "off"
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/srv/vlab-vcodex-streaming/workspace",
      "model": {
        "primary": "openai/gpt-5.6-sol",
        "fallbacks": []
      },
      "models": {
        "openai/gpt-5.6-sol": {
          "params": {
            "thinking": "medium"
          },
          "agentRuntime": {
            "id": "codex"
          }
        }
      },
      "thinkingDefault": "medium",
      "maxConcurrent": 2,
      "subagents": {
        "maxConcurrent": 2,
        "runTimeoutSeconds": 1800
      }
    },
    "list": [
      {
        "id": "vcodex-streaming",
        "name": "VCodex Streaming Lab",
        "description": "Fourth isolated VLab experiment for Codex-to-Feishu streaming acceptance.",
        "workspace": "/srv/vlab-vcodex-streaming/workspace",
        "agentDir": "/srv/vlab-vcodex-streaming/state/agents/vcodex-streaming/agent",
        "model": {
          "primary": "openai/gpt-5.6-sol",
          "fallbacks": []
        },
        "models": {
          "openai/gpt-5.6-sol": {
            "agentRuntime": {
              "id": "codex"
            }
          }
        },
        "thinkingDefault": "medium",
        "identity": {
          "name": "VCodex Streaming Lab",
          "emoji": "🧪"
        }
      }
    ]
  },
  "tools": {
    "profile": "coding"
  },
  "channels": {
    "feishu": {
      "enabled": true,
      "appId": "${VLAB_VCODEX_FEISHU_APP_ID}",
      "appSecret": "${VLAB_VCODEX_FEISHU_APP_SECRET}",
      "domain": "feishu",
      "connectionMode": "webhook",
      "verificationToken": "${VLAB_VCODEX_FEISHU_VERIFICATION_TOKEN}",
      "encryptKey": "${VLAB_VCODEX_FEISHU_ENCRYPT_KEY}",
      "webhookHost": "127.0.0.1",
      "webhookPort": 24994,
      "webhookPath": "/feishu-vcodex-streaming-events",
      "requireMention": false,
      "dmPolicy": "open",
      "groupPolicy": "open",
      "allowFrom": [
        "*"
      ],
      "groupAllowFrom": [
        "*"
      ],
      "streaming": true,
      "blockStreaming": false,
      "renderMode": "auto",
      "typingIndicator": false,
      "resolveSenderNames": false
    }
  },
  "plugins": {
    "allow": [
      "codex",
      "feishu"
    ],
    "entries": {
      "codex": {
        "enabled": true,
        "config": {
          "codexDynamicToolsLoading": "direct",
          "codexPlugins": {
            "enabled": false
          }
        }
      },
      "feishu": {
        "enabled": true
      }
    }
  }
}
