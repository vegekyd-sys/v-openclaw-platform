# One-time credential entry links for channels without a password box (PRODUCTION - not VLab).
# Public side 127.0.0.1:23960 is reached through cloudflared path ^/secret-entry(?:/.*)?$;
# admin side 127.0.0.1:23961 is loopback + bearer only (the Gateway reads the same token file).
# It calls the Gateway with OpenClaw's own CLI transport (question.resolve), so it runs as the
# Gateway's user with the Gateway's config and environment, and holds no Gateway credential itself.
# scripts/install-secret-entry-host.sh renders this file (user, paths, node) and adds the Gateway's
# EnvironmentFiles in a drop-in.
[Unit]
Description=V secret entry: one-time credential links (PRODUCTION - not VLab)
After=network.target openclaw-gateway.service

[Service]
Type=simple
User=openclaw
Group=openclaw
Environment=HOME=/home/openclaw
Environment=OPENCLAW_STATE_DIR=/home/openclaw/.openclaw
Environment=OPENCLAW_CONFIG_PATH=/home/openclaw/.openclaw/openclaw.json
ExecStart=/usr/bin/env node /opt/v-secret-entry/server.mjs /etc/v-secret-entry/config.json
Restart=on-failure
RestartSec=3
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
