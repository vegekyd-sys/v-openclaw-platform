[Unit]
Description=Keep V's memory_search vectors in the page cache
Documentation=file:/opt/v-sentinel/v-memory-vector-warm.py
# Read-only and outside the Gateway: no Gateway call, no write lock, nothing to
# order against. A cold vector table makes memory_search hit its 25 s deadline.

[Service]
Type=oneshot
User=openclaw
Nice=19
# V's vda uses mq-deadline, which ignores IO classes: what actually bounds the IO is the
# script's own brakes (IO PSI, MemAvailable, 10 s per pass, backoff when nothing stays cached).
IOSchedulingClass=idle
# Resume point and backoff (/var/lib/v-memory-vector-warm/<agent>.json).
StateDirectory=v-memory-vector-warm
ExecStart=/usr/bin/python3 /opt/v-sentinel/v-memory-vector-warm.py makaron
# A warm pass takes ~0.3 s; a pass stops itself after 10 s.
TimeoutStartSec=120
