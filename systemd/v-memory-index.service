[Unit]
Description=Bring V's memory_search index up to date with the memory files (incremental)
Documentation=file:/opt/v-sentinel/v-memory-index.sh
# Indexes with the running Gateway's own code and environment; nothing to do when it is down.
After=openclaw-gateway.service

[Service]
Type=oneshot
User=root
ExecStart=/opt/v-sentinel/v-memory-index.sh makaron
# Each run opens the agent DB with a full integrity pass (~90 s on V's 12 GB makaron DB).
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1h
