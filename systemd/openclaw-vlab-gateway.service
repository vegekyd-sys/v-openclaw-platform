[Unit]
Description=OpenClaw vLab isolated Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vlab
Group=vlab
WorkingDirectory=/srv/vlab/workspace
Environment=HOME=/srv/vlab
Environment=OPENCLAW_HOME=/srv/vlab
Environment=OPENCLAW_STATE_DIR=/srv/vlab/state
Environment=OPENCLAW_CONFIG_PATH=/srv/vlab/state/openclaw.json
Environment=OPENCLAW_WORKSPACE_DIR=/srv/vlab/workspace
Environment=OPENCLAW_GATEWAY_PORT=23793
Environment=NODE_ENV=production
EnvironmentFile=-/srv/vlab/state/makaron.env
Environment=NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
Environment=TMPDIR=/srv/vlab/tmp
Environment=PATH=/srv/vlab/node_modules/.bin:/opt/vlab/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/vlab/node/bin/node --inspect=127.0.0.1:9239 --max-old-space-size=4096 /opt/vlab/current/node_modules/openclaw/dist/index.js gateway --port 23793
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/vlab
RestrictSUIDSGID=true
LockPersonality=true
MemoryHigh=5G
MemoryMax=6G
CPUQuota=400%

[Install]
WantedBy=multi-user.target
