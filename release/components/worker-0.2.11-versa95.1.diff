@@ -0,0 +1,18 @@
+const delayMs = Number(process.env.VLAB_FAKE_WORKER_READY_DELAY_MS ?? 0);
+
+await new Promise((resolve) => setTimeout(resolve, delayMs));
+process.send?.({ type: "ready", pid: process.pid });
+
+process.on("message", async (message) => {
+  if (!message?.id) return;
+  const durationMs = Number(message.durationMs ?? 0);
+  if (durationMs > 0) {
+    await new Promise((resolve) => setTimeout(resolve, durationMs));
+  }
+  process.send?.({
+    type: "response",
+    id: message.id,
+    ok: true,
+    result: { workerPid: process.pid, slot: process.env.VLAB_WORKER_SLOT },
+  });
+});
diff -ruN captured/v2026.9.1-db91.6-feishu-progress-20260926.worker/dist/fake-detached-event-worker.mjs components/worker-0.2.11-versa95.1/fake-detached-event-worker.mjs
--- captured/v2026.9.1-db91.6-feishu-progress-20260926.worker/dist/fake-detached-event-worker.mjs	1970-01-01 08:00:00
+++ components/worker-0.2.11-versa95.1/fake-detached-event-worker.mjs	2026-09-24 14:15:02
@@ -0,0 +1,66 @@
+import {
+  WORKER_GATEWAY_EVENT_CONTRACT_VERSION,
+} from "./worker-gateway-events.mjs";
+
+const pendingAcks = new Map();
+
+function sendEvent(event) {
+  return new Promise((resolve, reject) => {
+    pendingAcks.set(event.eventId, { resolve, reject });
+    process.send?.({ type: "worker-gateway-event", event });
+  });
+}
+
+process.on("message", async (message) => {
+  if (message?.type === "worker-gateway-event-ack") {
+    const pending = pendingAcks.get(message.eventId);
+    if (!pending) return;
+    pendingAcks.delete(message.eventId);
+    if (message.ok) pending.resolve(message.result);
+    else pending.reject(new Error(message.error?.message ?? "event failed"));
+    return;
+  }
+  if (!message?.id) return;
+  if (message.kind === "hold") {
+    setTimeout(() => {
+      process.send?.({ type: "response", id: message.id, ok: true, result: {} });
+    }, Number(message.durationMs ?? 100));
+    return;
+  }
+  if (message.kind !== "detached") return;
+  const taskKey = `media:${message.taskId}`;
+  await sendEvent({
+    contractVersion: WORKER_GATEWAY_EVENT_CONTRACT_VERSION,
+    eventKind: "detached_task_started",
+    eventId: `${taskKey}:started`,
+    taskKey,
+  });
+  process.send?.({ type: "response", id: message.id, ok: true, result: {} });
+  setTimeout(async () => {
+    await sendEvent({
+      contractVersion: WORKER_GATEWAY_EVENT_CONTRACT_VERSION,
+      eventKind: "media_generation_completion",
+      eventId: `${taskKey}:completion`,
+      taskKey,
+      delivery: {
+        requesterSessionKey: "agent:makaron:explicit:parent",
+        targetRequesterSessionKey: "agent:makaron:explicit:parent",
+        announceId: `${taskKey}:ok`,
+        triggerMessage: "done",
+        steerMessage: "done",
+        internalEvents: [],
+        sourceSessionKey: taskKey,
+        sourceChannel: "internal",
+        sourceTool: "image_generate",
+      },
+    });
+    await sendEvent({
+      contractVersion: WORKER_GATEWAY_EVENT_CONTRACT_VERSION,
+      eventKind: "detached_task_settled",
+      eventId: `${taskKey}:settled`,
+      taskKey,
+    });
+  }, Number(message.detachedDurationMs ?? 250));
+});
+
+process.send?.({ type: "ready", pid: process.pid });
diff -ruN captured/v2026.9.1-db91.6-feishu-progress-20260926.worker/dist/fake-diagnostic-runtime.mjs components/worker-0.2.11-versa95.1/fake-diagnostic-runtime.mjs
--- captured/v2026.9.1-db91.6-feishu-progress-20260926.worker/dist/fake-diagnostic-runtime.mjs	1970-01-01 08:00:00
+++ components/worker-0.2.11-versa95.1/fake-diagnostic-runtime.mjs	2026-09-24 14:15:02
@@ -0,0 +1,17 @@
+const listeners = new Set();
+let sequence = 0;
+
+export function onInternalDiagnosticEvent(listener) {
+  listeners.add(listener);
+  return () => listeners.delete(listener);
+}
+
+export function emitFakeTrustedDiagnosticEvent(event) {
+  sequence += 1;
+  for (const listener of listeners) {
+    listener(
+      { ...event, seq: sequence, ts: Date.now() },
+      { trusted: true },
+    );
+  }
+}
diff -ruN captured/v2026.9.1-db91.6-feishu-progress-20260926.worker/dist/fake-gateway-owned-tool-runner.mjs components/worker-0.2.11-versa95.1/fake-gateway-owned-tool-runner.mjs
