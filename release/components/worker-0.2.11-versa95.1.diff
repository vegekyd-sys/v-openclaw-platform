diff -ruN captured/v2026.9.1-db91.6-feishu-model-20260924.worker/dist/runtime-prewarm.mjs components/worker-0.2.11-versa95.1/runtime-prewarm.mjs
--- captured/v2026.9.1-db91.6-feishu-model-20260924.worker/dist/runtime-prewarm.mjs	1970-01-01 08:00:00
+++ components/worker-0.2.11-versa95.1/runtime-prewarm.mjs	2026-09-25 02:54:56
@@ -0,0 +1,61 @@
+// Opt-in startup preparation only. Never issue an Agent/model/tool request.
+export async function prewarmWorkerRuntime({
+  enabled,
+  agentId = "makaron",
+  loadAgentRuntime,
+  loadCompactionRuntime,
+  preloadBuiltin = async () => {},
+  signal,
+}) {
+  if (!enabled) return { status: "disabled" };
+  const start = performance.now();
+  let lease;
+  try {
+    const agentRuntime = await loadAgentRuntime();
+    const { commandRuntime, configRuntime, preparedRuntime } =
+      await loadCompactionRuntime();
+    const config = configRuntime.loadConfig();
+    const workspaceDir = agentRuntime.resolveAgentWorkspaceDir(config, agentId);
+    lease = await preparedRuntime.acquireAgentRunPreparedModelRuntime(
+      {
+        config,
+        agentId,
+        agentDir: agentRuntime.resolveAgentDir(config, agentId),
+        allowGatewaySubagentBinding: true,
+        workspaceDir,
+      },
+      // Workers are long-lived runtimes without a Gateway lifecycle; 2026.9.5
+      // retires idle run owners unless asked to retain them.
+      { abortSignal: signal, catalogMode: "static", retainIdleRunOwner: true },
+    );
+    // The prepared model runtime above is the expensive part on 2026.9.5
+    // (plugin generation capture, catalog, registries); the command runtime
+    // prewarm only exists on some releases.
+    const commandPreparation =
+      typeof commandRuntime.prewarmAgentCommandRuntimes === "function"
+        ? await commandRuntime.prewarmAgentCommandRuntimes({
+            config,
+            agentId,
+            workspaceDir,
+            pluginMetadataSnapshot:
+              lease.pluginGeneration?.pluginMetadataSnapshot,
+          })
+        : undefined;
+    await preloadBuiltin();
+    return {
+      status: "ready",
+      ms: Math.round(performance.now() - start),
+      skillSnapshotPrepared:
+        commandPreparation?.skillSnapshotPrepared === true,
+    };
+  } catch (error) {
+    return {
+      status: "deferred-to-normal-turn",
+      errorCategory: error?.name === "AbortError" ? "abort" : "other",
+      ms: Math.round(performance.now() - start),
+    };
+  } finally {
+    if (typeof lease?.[Symbol.asyncDispose] === "function") await lease[Symbol.asyncDispose]();
+    else lease?.release?.();
+  }
+}
diff -ruN captured/v2026.9.1-db91.6-feishu-model-20260924.worker/dist/runtime-prewarm.test.mjs components/worker-0.2.11-versa95.1/runtime-prewarm.test.mjs
--- captured/v2026.9.1-db91.6-feishu-model-20260924.worker/dist/runtime-prewarm.test.mjs	1970-01-01 08:00:00
+++ components/worker-0.2.11-versa95.1/runtime-prewarm.test.mjs	2026-09-25 02:54:56
@@ -0,0 +1,76 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { prewarmWorkerRuntime } from "./runtime-prewarm.mjs";
+
+function fakeRuntimes({ commandPrewarm, acquireError } = {}) {
+  const calls = { acquire: [], disposed: 0, commandPrewarm: 0 };
+  const agentRuntime = {
+    resolveAgentWorkspaceDir: (_config, agentId) => `/workspaces/${agentId}`,
+    resolveAgentDir: (_config, agentId) => `/agents/${agentId}`,
+  };
+  const commandRuntime = commandPrewarm
+    ? {
+        prewarmAgentCommandRuntimes: async () => {
+          calls.commandPrewarm += 1;
+          return { skillSnapshotPrepared: true };
+        },
+      }
+    : {};
+  const preparedRuntime = {
+    acquireAgentRunPreparedModelRuntime: async (params, options) => {
+      if (acquireError) throw acquireError;
+      calls.acquire.push({ params, options });
+      return {
+        pluginGeneration: {},
+        [Symbol.asyncDispose]: async () => {
+          calls.disposed += 1;
+        },
+      };
+    },
+  };
+  return {
+    calls,
+    loadAgentRuntime: async () => agentRuntime,
+    loadCompactionRuntime: async () => ({
+      commandRuntime,
+      configRuntime: { loadConfig: () => ({}) },
+      preparedRuntime,
+    }),
+  };
+}
+
+test("prepares the agent's model runtime without a command runtime prewarm", async () => {
+  const runtimes = fakeRuntimes();
+  const result = await prewarmWorkerRuntime({ enabled: true, agentId: "main", ...runtimes });
+  assert.equal(result.status, "ready");
+  assert.equal(result.skillSnapshotPrepared, false);
+  assert.equal(runtimes.calls.acquire.length, 1);
+  assert.equal(runtimes.calls.acquire[0].params.agentId, "main");
+  assert.equal(runtimes.calls.acquire[0].params.workspaceDir, "/workspaces/main");
+  assert.equal(runtimes.calls.acquire[0].options.retainIdleRunOwner, true);
+  assert.equal(runtimes.calls.disposed, 1);
+});
+
+test("uses the command runtime prewarm when the release provides it", async () => {
+  const runtimes = fakeRuntimes({ commandPrewarm: true });
+  const result = await prewarmWorkerRuntime({ enabled: true, ...runtimes });
+  assert.equal(result.status, "ready");
+  assert.equal(result.skillSnapshotPrepared, true);
+  assert.equal(runtimes.calls.commandPrewarm, 1);
+});
+
+test("defers to the normal turn when preparation fails", async () => {
+  const runtimes = fakeRuntimes({ acquireError: new Error("catalog unavailable") });
+  const result = await prewarmWorkerRuntime({ enabled: true, ...runtimes });
+  assert.equal(result.status, "deferred-to-normal-turn");
+  assert.equal(result.errorCategory, "other");
+});
+
+test("does nothing when disabled", async () => {
+  const runtimes = fakeRuntimes();
+  assert.deepEqual(await prewarmWorkerRuntime({ enabled: false, ...runtimes }), {
+    status: "disabled",
+  });
+  assert.equal(runtimes.calls.acquire.length, 0);
+});
