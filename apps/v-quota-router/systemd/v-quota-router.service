[Unit]
Description=V quota router: move important sessions to subscription models while weekly quota would go unused
After=openclaw-gateway.service

[Service]
Type=oneshot
User=openclaw
Group=openclaw
Environment=HOME=/home/openclaw
Environment=OPENCLAW_CONFIG_PATH=/home/openclaw/.openclaw/openclaw.json
ExecStart=/opt/node-v22.23.1/bin/node /opt/v-quota-router/quota-router.mjs tick
TimeoutStartSec=120
Nice=10
# Read-only except its own state directory.
ProtectSystem=strict
ReadWritePaths=/home/openclaw/.openclaw/v-quota-router
PrivateTmp=yes
NoNewPrivileges=yes
