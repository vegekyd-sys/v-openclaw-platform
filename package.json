{
  "name": "@versa/v-platform",
  "version": "0.1.0-integration.1",
  "private": true,
  "type": "module",
  "description": "V-Platform versioned assembly and acceptance controller; not yet an installable runtime distribution",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.23.1",
    "npm": "use pnpm: corepack enable && pnpm install"
  },
  "bin": {
    "v-platform": "platform/cli.mjs"
  },
  "scripts": {
    "postinstall": "node scripts/captured-store.mjs link --soft --quiet",
    "test": "node platform/cli.mjs test",
    "check": "node platform/cli.mjs audit",
    "release:check": "node platform/cli.mjs release-check"
  },
  "devDependencies": {
    "@volcengine/rtc": "4.68.1"
  }
}
